# ── EasyClean production env (/opt/easyclean/.env) ─────────────────────────
# Copy to /opt/easyclean/.env and fill in. `docker compose` reads it, and the
# deploy workflow rewrites EASYCLEAN_IMAGE_TAG on every rollout.

# Which published image runs here. The deploy workflow rewrites this on every
# rollout, so you normally don't edit it — push a version tag instead. Set it by
# hand (e.g. 0.3.0, or sha-abc1234 for an exact commit) only to freeze/roll back
# without GitHub. `latest` is the right starting value before the first release.
EASYCLEAN_IMAGE_TAG=latest

# GHCR repo the image comes from (owner/repo, lowercase).
GITHUB_REPOSITORY=sai-zack-dev/easyclean

# ── Storage ────────────────────────────────────────────────────────────────
# Host folder holding per-user media: <MEDIA_ROOT>/<user>/source|clean|.trash
# Mounted READ-WRITE — EasyClean moves files between those folders.
MEDIA_ROOT=/srv/photos

# SQLite index + thumbnail cache + generated JWT secret. Back this up.
DATA_DIR=/opt/easyclean/data

# ── Access ─────────────────────────────────────────────────────────────────
# Host port and interface. 0.0.0.0 = reachable from the LAN. Use 127.0.0.1 if
# you front it with a reverse proxy or reach it only over Tailscale.
PORT=8080
BIND_ADDRESS=0.0.0.0

# Admin login. REQUIRED — there is no default passcode and the server refuses
# to start without one. It is re-applied on every boot, so changing it here and
# running `docker compose up -d` is how you rotate it.
EASYCLEAN_USER=admin
EASYCLEAN_PASSCODE=

# Multi-user (optional): "name:passcode[:role],name2:passcode2" — role is
# admin or user, defaulting to user. Setting this REPLACES the single seed
# above, so include every account you want, admin included. Each name needs a
# matching <MEDIA_ROOT>/<name>/source folder; users never see each other's.
#   EASYCLEAN_USERS=saiz:s3cret:admin,lily:her-passcode
EASYCLEAN_USERS=

# JWT signing secret. Leave EMPTY and the server generates one and keeps it at
# /data/secret.key (survives restarts and image upgrades). Set it explicitly
# only if you want to manage it yourself — minimum 32 characters, and the
# server refuses to start on anything shorter: openssl rand -hex 32
EASYCLEAN_SECRET=

# ── Tuning ─────────────────────────────────────────────────────────────────
# Server-wide policy. Duplicate sensitivity is deliberately NOT here: it is a
# per-user setting on the app's Settings screen, stored in the database.
#
# Days a deleted file stays in .trash before auto-purge.
EASYCLEAN_TRASH_RETENTION_DAYS=30
# Laplacian-variance cutoff: below this counts as blurry (lower = stricter).
# Still server-side only — there is no UI for it yet.
EASYCLEAN_BLUR_THRESHOLD=100

# error | warn | info | debug | trace
RUST_LOG=info

# ── Tailscale (optional remote access) ─────────────────────────────────────
# Uncomment COMPOSE_FILE to bring up the sidecar in deploy/docker-compose.tailscale.yml.
# It publishes EasyClean at https://<TS_HOSTNAME>.<tailnet>.ts.net for people on
# your tailnet only — not the internet. Full setup: deploy/README.md §5.
#COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml

# The machine name, and therefore the first label of the URL.
TS_HOSTNAME=saiz-easyclean
# Reusable + pre-authorized + tagged auth key (tskey-auth-…) from
# https://login.tailscale.com/admin/settings/keys. Tag it so the node never
# expires; an untagged node goes offline after its key expires and the URL
# stops answering with nothing in the app's logs to explain it.
TS_AUTHKEY=
# Node identity + HTTPS cert. Back it up with DATA_DIR; replacing it re-registers
# the node under a new name and invalidates every share you handed out.
TS_STATE_DIR=/opt/easyclean/tailscale
