# ── EasyClean environment (docker compose) ─────────────────────────────────
# Copy to `.env` and fill in. `docker compose up -d` reads this file.

# Folder containing per-user subfolders of media
# (<MEDIA_ROOT>/<user>/source|clean|.trash). Mounted read-write.
MEDIA_ROOT=/mnt/easystore/storage

# Host port to publish the web UI + API on.
PORT=8080

# Admin login seeded on first run. CHANGE THESE.
EASYCLEAN_USER=admin
EASYCLEAN_PASSCODE=change-me

# JWT signing secret — REQUIRED. Generate with: openssl rand -hex 32
EASYCLEAN_SECRET=

# Days a deleted file stays in .trash before auto-purge.
EASYCLEAN_TRASH_RETENTION_DAYS=30

# Log level: error | warn | info | debug | trace
RUST_LOG=info
