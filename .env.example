# ── EasyClean (docker compose) ─────────────────────────────────────────────
# Copy to `.env` and fill in. `docker compose up -d` reads it.
#
# These five are the whole file on purpose. Every other setting has a working
# default in the server, so repeating it here would only be noise.

# Folder holding per-user media: <MEDIA_ROOT>/<user>/source|clean|.trash
# Mounted read-write — EasyClean moves files between those three.
MEDIA_ROOT=/mnt/easystore/storage

# Host port for the web UI + API.
PORT=8080

# Admin login. REQUIRED — there is no default passcode and the server will not
# start without one. Re-applied on every boot, so editing it here and
# restarting is how you change the passcode.
EASYCLEAN_USER=admin
EASYCLEAN_PASSCODE=

# JWT signing key. Optional — leave empty and the server generates one into
# data/secret.key on first boot and reuses it. Set it to manage rotation
# yourself (at least 32 characters): openssl rand -hex 32
EASYCLEAN_SECRET=

# ── Rarely needed ──────────────────────────────────────────────────────────
# Uncomment only to override the default. Duplicate sensitivity is NOT here:
# it is a per-user setting in the app's Settings screen.
#
# EASYCLEAN_TRASH_RETENTION_DAYS=30   # days in .trash before auto-purge
# RUST_LOG=info                       # error | warn | info | debug | trace
