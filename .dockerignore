# Build artifacts — recompiled inside the image
target/
**/target/
web/node_modules/
web/dist/

# App runtime data
data/
.m1data/
tmp/

# The desktop (Tauri) crate isn't part of the headless server image; the
# Dockerfile drops it from the workspace members list.
desktop/

# Docs and the deploy kit: consumed on the host, never inside the image.
deploy/
.claude/
.github/
*.md

# VCS / editor / OS
.git/
.gitignore
**/.DS_Store
*.rs.bk
.env
